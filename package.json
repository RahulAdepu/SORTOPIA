{
  "name": "sortopia",
  "version": "1.0.0",
  "private": true,
  "description": "Sortopia: The Ultimate Color Sort Challenge — a YouTube Playables puzzle game by MindGrid Labs Pvt. Ltd.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "levels:generate": "tsx scripts/generate-levels.ts",
    "levels:validate": "tsx scripts/validate-levels.ts",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "audio:build": "node scripts/build-audio.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run bundle:check"
  },
  "author": "MindGrid Labs Pvt. Ltd.",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.2.8",
    "@vercel/speed-insights": "^2.1.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ffmpeg-static": "^5.2.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
